# Copy to .env.local (root, for the Supabase CLI) and apps/web/.env.local (web app).
# Never commit real values.

# Supabase CLI only (never used by the web app)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Web app (public by design; use the anon/publishable key, NEVER service_role/secret)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STOP_ID=STOP-01

# Demo logins (apps/web/.env.local, and Vercel). "true" shows "Demo login as…" on /login:
# anyone with the URL can then sign in as any role, so turn it off for anything real.
NEXT_PUBLIC_DEMO_MODE=false
# Shared password of the five demo accounts. Server-only (no NEXT_PUBLIC_ prefix): used by
# /api/demo-login and the simulator, never sent to the browser.
DEMO_PASSWORD=
